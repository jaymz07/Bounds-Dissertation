@inbook{book_ultrashort_lp_phenom_CH5,
title = {Ultrashort Sources I: Fundamentals},
editor = {Jean-Claude Diels and Wolfgang Rudolph},
booktitle = {Ultrashort Laser Pulse Phenomena (Second Edition)},
chapter = {5},
publisher = {Academic Press},
edition = {Second Edition},
address = {Burlington},
pages = {277-339},
year = {2006},
isbn = {978-0-12-215493-5},
doi = {https://doi.org/10.1016/B978-012215493-5/50006-9},
url = {https://www.sciencedirect.com/science/article/pii/B9780122154935500069},
author = {Jean-Claude Diels and Wolfgang Rudolph},
abstract = {Publisher Summary
This chapter deals with the properties of the laser cavity. It reviews the analysis of the most common compression schemes. The dispersive mechanisms such as the self-phase modulation (SPM) and compression take over from the picoseconds (ps) to the femtoseconds (fs) range. There are mechanisms of pulse broadening that prevent the pulse compression from proceeding indefinitely in the cavity. The simplest broadening arises from the bandwidth limitation of the cavity (bandwidth of the difference spectrum of gains and losses). The pulse width limitations arise from the higher-order dispersion of the optical components and nonlinear effect (four wave mixing coupling in dye jets, two photon absorption, Kerr effect). The pulse evolution in a continuous wave (cw) pumped laser leads to a steady state, in which the pulse reproduces itself after an integer number of cavity round trips (ideally one). The pulse parameters are such that the gain and loss, the compression and broadening mechanisms, as well as the shaping effects, balance each other.}
}

