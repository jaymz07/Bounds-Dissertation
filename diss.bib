@article{mock_SELBY196621,
title = {Mock interferometer—I theory},
journal = {Infrared Physics},
volume = {6},
number = {1},
pages = {21-32},
year = {1966},
issn = {0020-0891},
doi = {https://doi.org/10.1016/0020-0891(66)90020-0},
url = {https://www.sciencedirect.com/science/article/pii/0020089166900200},
author = {M.J. Selby},
abstract = {A full theoretical treatment is given of a multislit spectrometric device—the mock interferometer, so named because it simulates the output from the Michelson Interferometer, and takes the Fourier transform of the wavelength intensity function. A study is made of the limitations which restrict the luminosity of one form of the device, culminating in the calculation of its resolving power and luminosity product, so that a comparison can be made with interferometers in general. Finally, it is suggested how the resolving power of the mock interferometer can be increased by the addition of a Fabry Perot monochromator; this system has advantages over the normal Fabry Perot and single slit grating combination.}
}

